package pages

import (
	"github.com/mirairoad/howl-go/core/router"

	"github.com/mirairoad/appeditions/client/view"
)

// app.templ is the document shell: a reserved name, never a route, rendered
// only for a cold request. A local navigation swaps `#outlet` and nothing else,
// so anything in here that depended on the route would freeze on whichever page
// was loaded first — which is why the navigation lives in layout.templ.
templ App(title, head string) {
	<!DOCTYPE html>
	<html lang="en" class="style-nova">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<!-- Exactly one <title>. A page's own Head() supplies it; two of
			     them and the browser keeps the first, so the page would lose. -->
			<title>{ title }</title>
			<link rel="stylesheet" href={ router.Asset(ctx, "app.css") }/>
			@templ.JSONScript("howl-client", router.ClientConfig(ctx))
			<script src={ router.Asset(ctx, "app.js") } type="module"></script>
			<script src={ router.Asset(ctx, "forge.js") } type="module"></script>
			<!--page-head-->
			@templ.Raw(head)
			<!--/page-head-->
		</head>
		<!-- No hover prefetching, and no fragment swaps for links.
		
		     Both exist to hide a network round trip, and there is no network
		     here: the server is in this process. What a swap costs instead is
		     that #outlet is replaced — the top bar and the sidebar are torn
		     down and rebuilt on every step change — and that a fragment
		     rendered before the click that uses it describes a state which has
		     since moved on.
		
		     data-no-prefetch stops the hover fetch; the framework reads it off
		     the nearest ancestor, so once here it covers every link. Its
		     sibling `data-no-spa` is read off the anchor itself, so it cannot
		     be set once — turning links into document loads is a listener in
		     forge.js instead. -->
		<body class="min-h-screen bg-background font-sans text-foreground antialiased" data-no-prefetch>
			<!-- The chrome's colour, and nothing else: a top band the height of
			     the bar, and a left column the width of the workspace sidebar.
			
			     It is here, outside #outlet, because a navigation replaces the
			     outlet's contents wholesale — the bar and the sidebar are torn
			     down and rebuilt as new nodes on every step change, and the
			     frame between the two is where the flash was. This does not
			     move, so the dark shapes are continuous and the rebuild
			     happens on top of its own colour.
			
			     It draws nothing on its own: the rules key off whether the
			     page actually has a sidebar, so the index and the templates
			     page get the band and no column. -->
			<div data-chrome-backdrop aria-hidden="true"></div>
			<main id="outlet" data-route={ router.Current(ctx) }>
				{ children... }
			</main>
		</body>
	</html>
}

templ NotFound(path string) {
	<section class="mx-auto max-w-lg px-6 py-24 text-center">
		<h1 class="text-2xl font-semibold">Nothing here</h1>
		<p class="mt-2 text-sm text-muted-foreground">
			No page at <code class="font-mono">{ path }</code>.
		</p>
		<a href="/" class="mt-6 inline-block text-sm text-primary underline underline-offset-4">Back to your projects</a>
	</section>
}

// footerNote is the one place the data directory is named. A tool that writes
// files somewhere should say where, on every page, without being asked.
templ footerNote() {
	{{ shell := view.ShellOf(ctx) }}
	<p class="text-xs text-chrome-foreground/60">
		Files live in <code class="font-mono">{ shell.DataDir }</code>
	</p>
}
